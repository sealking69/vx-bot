# === 微信配置 ===
# 公众号 AppID（在 https://mp.weixin.qq.com 后台 -> 开发 -> 基本配置 获取）
WECHAT_APP_ID=wx0000000000000000
# 公众号 AppSecret
WECHAT_APP_SECRET=your_app_secret_here
# 服务器配置 Token（自己设定的任意字符串，与公众号后台填的一致）
WECHAT_TOKEN=your_custom_token_here

# === 你的微信 OpenID（用于主动发消息） ===
# 关注公众号后，发一条消息，服务器日志会打印出来
# 或者通过微信接口获取：https://api.weixin.qq.com/cgi-bin/user/get?access_token=TOKEN
WECHAT_USER_OPENID=

# === 主动消息设置 ===
# 是否开启主动发消息（true/false）
PROACTIVE_CHAT=true
# 主动消息间隔范围（秒），默认 3-6 小时随机
PROACTIVE_INTERVAL_MIN=10800
PROACTIVE_INTERVAL_MAX=21600

# === OpenAI 配置 ===
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === 服务器端口 ===
PORT=8000
